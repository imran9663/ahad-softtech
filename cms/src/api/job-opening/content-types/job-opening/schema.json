{
  "kind": "collectionType",
  "collectionName": "job_openings",
  "info": {
    "singularName": "job-opening",
    "pluralName": "job_openings",
    "displayName": "Job Opening"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "department": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "internship",
        "temporary"
      ],
      "default": "full_time"
    },
    "workMode": {
      "type": "enumeration",
      "enum": [
        "onsite",
        "hybrid",
        "remote"
      ],
      "default": "onsite"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "responsibilities": {
      "type": "richtext"
    },
    "requirements": {
      "type": "richtext"
    },
    "benefits": {
      "type": "richtext"
    },
    "applicationDeadline": {
      "type": "datetime"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-application.job-application",
      "mappedBy": "jobOpening"
    }
  }
}
