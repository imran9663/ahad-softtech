{
    "kind": "collectionType",
    "collectionName": "navigations",
    "info": {
        "singularName": "navigation",
        "pluralName": "navigations",
        "displayName": "Navigation Item"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "label": {
            "type": "string",
            "required": true
        },
        "url": {
            "type": "string",
            "required": true
        },
        "openInNewTab": {
            "type": "boolean",
            "default": false
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "active": {
            "type": "boolean",
            "default": true
        },
        "parent": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::navigation.navigation",
            "inversedBy": "children"
        },
        "children": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::navigation.navigation",
            "mappedBy": "parent"
        }
    }
}