# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_CMS_URL=https://cms.example.com
IS_PROXIED=true

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=ahad_softtech
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-strong-password
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Strapi secrets - generate unique values per environment
APP_KEYS=replace-with-4-random-values
API_TOKEN_SALT=replace-with-secure-random-value
ADMIN_JWT_SECRET=replace-with-secure-random-value
TRANSFER_TOKEN_SALT=replace-with-secure-random-value
JWT_SECRET=replace-with-secure-random-value
ADMIN_ENCRYPTION_KEY=replace-with-secure-random-value

# API / uploads
API_DEFAULT_LIMIT=25
API_MAX_LIMIT=100
UPLOAD_SIZE_LIMIT=10485760

# Phase 1 bootstrap controls - keep disabled in production after setup
ENABLE_PUBLIC_API_PERMISSION_BOOTSTRAP=false
ENABLE_CMS_SEED=false

# Transactional email provider HTTP API
EMAIL_API_URL=https://api.example-email-provider.test/send
EMAIL_API_KEY=replace-with-secret
EMAIL_FROM=website@example.com
EMAIL_TO=leads@example.com
