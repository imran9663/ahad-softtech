# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_CMS_URL=https://cms.example.com
IS_PROXIED=true

# PostgreSQL / Supabase
# For a persistent Strapi backend, use Supabase Session Pooler on port 5432.
# For migrations/administrative tooling, Supabase documents direct connections separately.
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# For strongest verification, download the Supabase CA certificate and set DATABASE_SSL_CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA=/run/secrets/supabase-ca.crt
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT=60000
DATABASE_POOL_CREATE_TIMEOUT=60000
DATABASE_POOL_IDLE_TIMEOUT=30000

# Strapi secrets - generate unique values per environment
APP_KEYS=replace-with-4-random-values
API_TOKEN_SALT=replace-with-secure-random-value
ADMIN_JWT_SECRET=replace-with-secure-random-value
TRANSFER_TOKEN_SALT=replace-with-secure-random-value
JWT_SECRET=replace-with-secure-random-value
ADMIN_ENCRYPTION_KEY=replace-with-secure-random-value

# API / uploads
API_DEFAULT_LIMIT=25
API_MAX_LIMIT=100
UPLOAD_SIZE_LIMIT=10485760

# Phase 1 bootstrap controls - keep disabled in production after setup
ENABLE_PUBLIC_API_PERMISSION_BOOTSTRAP=false
ENABLE_CMS_SEED=false

# Transactional email provider HTTP API
EMAIL_API_URL=https://api.example-email-provider.test/send
EMAIL_API_KEY=replace-with-secret
EMAIL_FROM=website@example.com
EMAIL_TO=leads@example.com
